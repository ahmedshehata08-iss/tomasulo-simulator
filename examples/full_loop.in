# Additional complete three-iteration loop with -8 word branch offset.
# Author: Ahmed Ahmed
# Assignment model: one CDB, one memory port, word branch offsets.

# of rs              Cycles in EX    Cycles in Mem    # of FUs
Integer adder           4               1                          1
FP adder                3               4                          1
FP multiplier           2              15                          1
Load/store unit         5               1               5          1

ROB entries = 64
Issue width = 1
R1=12, R2=32, F20=3.0
Mem[4]=3, Mem[8]=2, Mem[12]=1, Mem[24]=6, Mem[28]=5, Mem[32]=4

# Additional test: byte offset -32 returns from instruction 8 to instruction 1.
# The supplied starter uses -12, which repeats only the pointer-update tail.
Ld F2 0(R1)
Mult.d F4 F2 F20
Ld F6 0(R2)
Add.d F6 F4 F6
Sd F6 0(R2)
Addi R1 R1 -4
Addi R2 R2 -4
Bne R1 R0 -8
Add.d F20 F2 F2
