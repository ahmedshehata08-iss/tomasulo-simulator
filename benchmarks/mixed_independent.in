# Twenty-eight independent instructions spread across four functional units.
# Long-latency multiplies expose the benefit of earlier issue, while the single
# CDB, single memory port, and one FU of each type limit total throughput.
# Initial source registers F20..F23 and R1..R3 are never overwritten.
Integer adder   12   1       1
FP adder        12   4       1
FP multiplier   12   16      1
Load/store unit 12   1   3   1
ROB entries = 64
R1=0, R2=3, R3=7
F20=1.5, F21=2, F22=4, F23=8
Mem[0]=10, Mem[4]=20, Mem[8]=30, Mem[12]=40
Mem[16]=50, Mem[20]=60, Mem[24]=70

Add R10 R2 R3
Add.d F1 F20 F21
Mult.d F2 F20 F22
Ld F3 0(R1)
Addi R11 R2 1
Add.d F4 F21 F22
Mult.d F5 F21 F23
Ld F6 4(R1)
Sub R12 R3 R2
Sub.d F7 F23 F20
Mult.d F8 F22 F23
Ld F9 8(R1)
Add R13 R3 R3
Add.d F10 F22 F23
Mult.d F11 F20 F23
Ld F12 12(R1)
Addi R14 R3 -2
Sub.d F13 F22 F21
Mult.d F14 F21 F22
Ld F15 16(R1)
Add R15 R2 R2
Add.d F16 F20 F23
Mult.d F17 F20 F21
Ld F18 20(R1)
Sub R16 R2 R3
Add.d F19 F21 F23
Mult.d F24 F20 F20
Ld F25 24(R1)
