# Terminating variation of handout example. Only R3 initialization is changed to 20.
# Author: Ahmed Ahmed
# Assignment model: one CDB, one memory port, word branch offsets.

# of rs              Cycles in EX    Cycles in Mem    # of FUs
Integer adder           2               1                          1
FP adder                3               3                          1
FP multiplier           2              20                          1
Load/store unit         3               1               4          1

ROB entries = 128
Issue width = 2
R1=10, R2=20, R3=20, F2=30.1
Mem[4]=1, Mem[8]=2, Mem[12]=3.4

Add.d F1, F2, F3
Ld F4, 8(R1)
Bne R2, R3, -3
